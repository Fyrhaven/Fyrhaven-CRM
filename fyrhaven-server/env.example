# Fyrhaven record server, self-hosted — copy to `.env` and fill in the values.
#
#   cp env.example .env
#
# The three that are required:
#
#   STORE_TOKENS       one token per workspace: `abc123=default,def456=team`
#   STORE_MASTER_KEY   `openssl rand -base64 32`  (32 bytes, base64)
#   FYRHAVEN_LICENCE   the key from your order, bound to this installation
#   CRM_DOMAIN         the public hostname, when you use the bundled Caddy
#
# Optional:
#
#   STORE_ADMIN_TOKEN     enables /v1/admin, which moves a workspace's bytes
#                         between SQLite and a bucket (#158); off when empty
#   ALLOW_QUERY_TOKEN     1 accepts `?token=` as well as the header (leaks into logs)
#   STORE_AUTH_USER       protect the whole server with HTTP Basic…
#   STORE_AUTH_PASSWORD   …instead of, or as well as, workspace tokens
#   FYRHAVEN_ACTIVATION   `online` fetches the licence instead of pasting one
#   FYRHAVEN_ACTIVATION_URL / FYRHAVEN_ACTIVATION_TOKEN
#   R2_S3_API             to keep records in a bucket instead of the SQLite file:
#   R2_ACCESS_KEY_ID      all three are needed, or blob storage stays off.
#   R2_SECRET_ACCESS_KEY
STORE_TOKENS=
STORE_MASTER_KEY=
FYRHAVEN_LICENCE=
CRM_DOMAIN=
