{
  "name": "bulwark-plugin-contact-manager",
  "version": "1.19.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=cjs --platform=browser --target=es2020 --charset=utf8 --outfile=dist/index.js --external:react --external:react-dom --external:react-dom/client --external:react/jsx-runtime --external:@plugin-host --external:@plugin-host/ui",
    "package": "npm run build && node scripts/package.mjs",
    "release": "node scripts/release.mjs",
    "ship": "node scripts/ship.mjs",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "esbuild": "^0.28.1",
    "jsdom": "^28.1.0",
    "jszip": "^3.10.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "vitest": "^4.1.11"
  }
}
